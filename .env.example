TELEGRAM_BOT_TOKEN=your_token
YOUR_CHAT_ID=123456789
ANTHROPIC_API_KEY=sk-ant-xxx
PLANNING_AGENT=codex

# Native DeepSeek API planner (OpenAI-compatible Chat Completions).
# DEEPSEEK_API_KEY is required only when PLANNING_AGENT=deepseek.
# DEEPSEEK_API_KEY=sk-deepseek-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_SECONDS=120
# DEEPSEEK_MAX_OUTPUT_TOKENS=8192
# DEEPSEEK_MAX_OUTPUT_CHARS=20000
# AUTONOMOUS_DEEPSEEK_ENABLED=false
REPO_PATH=/home/ubuntu/your-project
GITHUB_REPOSITORY=owner/repo
PROJECTS_FILE=/etc/ai-agent-projects.json
PROJECTS_ROOT=/opt/projects
AGENT_STATE_FILE=/var/lib/ai-coding-agent/state.json
AGENT_SNAPSHOT_FILE=/var/lib/ai-coding-agent/snapshot.json
RULES_ENABLED=true
RULES_REPO_PATH=/opt/ai-rules
RULES_REPO_URL=git@github.com:ramunl/ai-rules.git
RULES_PROJECT_NAME=channel-cast

# Passive subscription quota capture from interactive Claude Code sessions.
CLAUDE_CODE_LIMITS_FILE=/var/lib/ai-coding-agent/claude-code-limits.json

# Private task attachments, outside all Git repositories.
IMAGE_DIR=/var/lib/ai-coding-agent/images
IMAGE_STORAGE_CAP_BYTES=5000000000
IMAGE_MAX_BYTES=10000000
IMAGE_MAX_PER_TASK=5

# Stage non-root provider execution only after provisioning worker tools,
# credentials, owned directories and validating the migration via Ops.
WORKER_ISOLATION_ENABLED=false
