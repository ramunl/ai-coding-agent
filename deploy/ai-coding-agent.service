[Unit]
Description=Telegram AI coding agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# DS12: the whole bot runs as the dedicated non-root worker. The implementer
# provider CLI also runs as this user (the subprocess user=/group= drop is a
# no-op when the service is already the worker), inside a worker-owned sandbox.
User=ai-coding-runner
Group=ai-coding-runner
WorkingDirectory=/opt/ai-coding-agent
StateDirectory=ai-coding-agent ai-coding-agent/work ai-coding-agent/home
Environment=HOME=/var/lib/ai-coding-agent/home
EnvironmentFile=/etc/ai-coding-agent/ai-coding-agent.env
ExecStartPre=/usr/bin/git -C /opt/ai-coding-agent submodule update --init --recursive
ExecStart=/opt/ai_coding_venv/bin/python /opt/ai-coding-agent/agent.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# DS12 hardening: the worker can never escalate, /etc and /usr are read-only,
# real user homes are unavailable, and /tmp is private to the service.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
