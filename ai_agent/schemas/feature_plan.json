{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch",
    "summary",
    "files",
    "steps",
    "risks",
    "repositories"
  ],
  "properties": {
    "branch": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "repositories": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "changes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          }
        }
      }
    }
  }
}
