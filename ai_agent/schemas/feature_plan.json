{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch",
    "summary",
    "files",
    "steps",
    "risks",
    "repositories",
    "scope_assessment",
    "repository_accounting",
    "verification_profile"
  ],
  "properties": {
    "branch": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "repositories": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "changes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          }
        }
      }
    },
    "scope_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommend_split",
        "reason",
        "milestones"
      ],
      "properties": {
        "recommend_split": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "milestones": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "acceptance",
              "repository"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "repository": {
                "type": "string",
                "maxLength": 100
              },
              "acceptance": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "repository_accounting": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "reason",
          "evidence",
          "checked_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "role": {
            "type": "string",
            "maxLength": 500,
            "enum": [
              "change",
              "verify",
              "completed",
              "context",
              "unclear"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "evidence": {
            "type": "string",
            "maxLength": 500
          },
          "checked_at": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "verification_profile": {
      "type": "string",
      "enum": [
        "",
        "ai-coding-agent:baseline-v1",
        "ai-pm-agent:baseline-v1",
        "ai-ops-agent:baseline-v1",
        "ai-dashboard:baseline-v1"
      ]
    }
  }
}
