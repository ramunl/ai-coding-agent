{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch",
    "summary",
    "files",
    "steps",
    "risks",
    "repositories",
    "scope_assessment"
  ],
  "properties": {
    "branch": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "repositories": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "changes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          }
        }
      }
    },
    "scope_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommend_split",
        "reason",
        "milestones"
      ],
      "properties": {
        "recommend_split": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "milestones": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "acceptance"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "acceptance": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  }
}
